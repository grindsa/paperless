# Docker Compose variables for paperless stack

# MariaDB
MARIADB_DATABASE=paperless
MARIADB_USER=paperless
MARIADB_PASSWORD=CHANGE_ME
MARIADB_ROOT_PASSWORD=CHANGE_ME

# Paperless volume mounts on host
PAPERLESS_DATA_DIR=/srv/data/paperless/data
PAPERLESS_MEDIA_DIR=/srv/data/paperless/media
PAPERLESS_EXPORT_DIR=/srv/data/paperless/export
PAPERLESS_CONSUME_DIR=/srv/data/paperless/consume

# Paperless container/db wiring
PAPERLESS_DBPORT=3306
PAPERLESS_URL=https://paperless.example.com
PAPERLESS_ALLOWED_HOSTS=paperless.example.com
PAPERLESS_CSRF_TRUSTED_ORIGINS=https://paperless.example.com
PAPERLESS_TRUSTED_PROXIES=172.18.0.0/16
PAPERLESS_USE_X_FORWARD_HOST=true

# Runtime user mapping
USERMAP_UID=1000
USERMAP_GID=1000

# Additional paperless settings
PAPERLESS_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
PAPERLESS_TIME_ZONE=Europe/Berlin
PAPERLESS_OCR_LANGUAGE=deu
PAPERLESS_CONSUMER_SUBDIRS_AS_TAGS=true
PAPERLESS_CONSUMER_RECURSIVE=true

# Backup settings
BACKUP_ROOT=/tmp/paperless-backups
TMP_ROOT=/tmp
REMOTE_TARGET=user@example-host
REMOTE_DIR=/public/Backups/web-srv/paperless
SSH_KEY=/home/user/.ssh/id_ed25519

# Retention
LOCAL_KEEP=3
REMOTE_KEEP=12

# WhatsApp notification (host venv send path)
WA_ADMIN_NUMBER=491234567890
WA_SRV=192.168.123.38
WA_PORT=9009
WA_PYTHON_BIN=/home/user/.venv/bin/python

# Optional override variables (normally not needed)
# WA_NOTIFY_NUMBER=491234567890
# WA_NOTIFY_SRV=192.168.123.38
# WA_NOTIFY_PORT=9009

# Compose file path for paperless stack
COMPOSE_FILE_PATH=/srv/stacks/paperless/docker-compose.yml

# Paperless env file path used by backup script
PAPERLESS_ENV_FILE=/srv/stacks/paperless/.env
